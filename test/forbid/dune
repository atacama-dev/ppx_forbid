;; A malformed, unknown or dangling config line, a missing include and a missing
;; --config file are config errors.

(rule
 (deps
  plain.ml
  bad_allow.ppx_forbid
  bad_allow_syntax.ppx_forbid
  bad_allow_without_rules.ppx_forbid
  bad_exempt_reason.ppx_forbid
  bad_function_no_module.ppx_forbid
  bad_missing_include.ppx_forbid
  bad_module_no_reason.ppx_forbid
  bad_only_syntax.ppx_forbid
  bad_unknown_directive.ppx_forbid
  bad_unknown_target.ppx_forbid)
 (action
  (with-stderr-to
   config_errors.out
   (with-stdout-to
    %{null}
    (progn
     (with-accepted-exit-codes
      2
      (run
       %{exe:../driver/driver.exe}
       --config
       bad_allow.ppx_forbid
       -impl
       plain.ml))
     (with-accepted-exit-codes
      2
      (run
       %{exe:../driver/driver.exe}
       --config
       bad_allow_syntax.ppx_forbid
       -impl
       plain.ml))
     (with-accepted-exit-codes
      2
      (run
       %{exe:../driver/driver.exe}
       --config
       bad_allow_without_rules.ppx_forbid
       -impl
       plain.ml))
     (with-accepted-exit-codes
      2
      (run
       %{exe:../driver/driver.exe}
       --config
       bad_exempt_reason.ppx_forbid
       -impl
       plain.ml))
     (with-accepted-exit-codes
      2
      (run
       %{exe:../driver/driver.exe}
       --config
       bad_function_no_module.ppx_forbid
       -impl
       plain.ml))
     (with-accepted-exit-codes
      2
      (run
       %{exe:../driver/driver.exe}
       --config
       bad_missing_include.ppx_forbid
       -impl
       plain.ml))
     (with-accepted-exit-codes
      2
      (run
       %{exe:../driver/driver.exe}
       --config
       bad_module_no_reason.ppx_forbid
       -impl
       plain.ml))
     (with-accepted-exit-codes
      2
      (run
       %{exe:../driver/driver.exe}
       --config
       bad_only_syntax.ppx_forbid
       -impl
       plain.ml))
     (with-accepted-exit-codes
      2
      (run
       %{exe:../driver/driver.exe}
       --config
       bad_unknown_directive.ppx_forbid
       -impl
       plain.ml))
     (with-accepted-exit-codes
      2
      (run
       %{exe:../driver/driver.exe}
       --config
       bad_unknown_target.ppx_forbid
       -impl
       plain.ml))
     (with-accepted-exit-codes
      2
      (run
       %{exe:../driver/driver.exe}
       --config
       no_such.ppx_forbid
       -impl
       plain.ml)))))))

(rule
 (alias runtest)
 (action
  (diff config_errors.expected config_errors.out)))

;; --report prints every hit (forbidden, suppressed, exempt) and succeeds.

(rule
 (deps rules.ppx_forbid async_report.ml codec_report.ml)
 (action
  (with-stderr-to
   report.out
   (with-stdout-to
    %{null}
    (progn
     (run
      %{exe:../driver/driver.exe}
      --config
      rules.ppx_forbid
      --report
      -impl
      async_report.ml)
     (run
      %{exe:../driver/driver.exe}
      --config
      rules.ppx_forbid
      --report
      -impl
      codec_report.ml))))))

(rule
 (alias runtest)
 (action
  (diff report.expected report.out)))
