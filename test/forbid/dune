;; Driver cases over rules.ppx_forbid. Every *fail_* file must be rejected with
;; the message recorded in failures.expected; every ok file must be accepted.

(rule
 (deps
  rules.ppx_forbid
  async_fail_alias.ml
  async_fail_attr_elsewhere.ml
  async_fail_call.ml
  async_fail_constructor.ml
  async_fail_inherit.ml
  async_fail_label.ml
  async_fail_module_type.ml
  async_fail_new.ml
  async_fail_pattern.ml
  async_fail_record.ml
  fail_alias.ml
  fail_first_class.ml
  fail_function.ml
  fail_functor_arg.ml
  fail_include.ml
  fail_let_open.ml
  fail_local_open.ml
  fail_mangled.ml
  fail_open.ml
  fail_open_bang.ml
  fail_qualified.ml
  fail_stdlib_prefix.ml
  fail_submodule.ml)
 (action
  (with-stderr-to
   failures.out
   (with-stdout-to
    %{null}
    (progn
     (with-accepted-exit-codes
      1
      (run
       %{exe:../driver/driver.exe}
       --config
       rules.ppx_forbid
       -impl
       async_fail_alias.ml))
     (with-accepted-exit-codes
      1
      (run
       %{exe:../driver/driver.exe}
       --config
       rules.ppx_forbid
       -impl
       async_fail_attr_elsewhere.ml))
     (with-accepted-exit-codes
      1
      (run
       %{exe:../driver/driver.exe}
       --config
       rules.ppx_forbid
       -impl
       async_fail_call.ml))
     (with-accepted-exit-codes
      1
      (run
       %{exe:../driver/driver.exe}
       --config
       rules.ppx_forbid
       -impl
       async_fail_constructor.ml))
     (with-accepted-exit-codes
      1
      (run
       %{exe:../driver/driver.exe}
       --config
       rules.ppx_forbid
       -impl
       async_fail_inherit.ml))
     (with-accepted-exit-codes
      1
      (run
       %{exe:../driver/driver.exe}
       --config
       rules.ppx_forbid
       -impl
       async_fail_label.ml))
     (with-accepted-exit-codes
      1
      (run
       %{exe:../driver/driver.exe}
       --config
       rules.ppx_forbid
       -impl
       async_fail_module_type.ml))
     (with-accepted-exit-codes
      1
      (run
       %{exe:../driver/driver.exe}
       --config
       rules.ppx_forbid
       -impl
       async_fail_new.ml))
     (with-accepted-exit-codes
      1
      (run
       %{exe:../driver/driver.exe}
       --config
       rules.ppx_forbid
       -impl
       async_fail_pattern.ml))
     (with-accepted-exit-codes
      1
      (run
       %{exe:../driver/driver.exe}
       --config
       rules.ppx_forbid
       -impl
       async_fail_record.ml))
     (with-accepted-exit-codes
      1
      (run
       %{exe:../driver/driver.exe}
       --config
       rules.ppx_forbid
       -impl
       fail_alias.ml))
     (with-accepted-exit-codes
      1
      (run
       %{exe:../driver/driver.exe}
       --config
       rules.ppx_forbid
       -impl
       fail_first_class.ml))
     (with-accepted-exit-codes
      1
      (run
       %{exe:../driver/driver.exe}
       --config
       rules.ppx_forbid
       -impl
       fail_function.ml))
     (with-accepted-exit-codes
      1
      (run
       %{exe:../driver/driver.exe}
       --config
       rules.ppx_forbid
       -impl
       fail_functor_arg.ml))
     (with-accepted-exit-codes
      1
      (run
       %{exe:../driver/driver.exe}
       --config
       rules.ppx_forbid
       -impl
       fail_include.ml))
     (with-accepted-exit-codes
      1
      (run
       %{exe:../driver/driver.exe}
       --config
       rules.ppx_forbid
       -impl
       fail_let_open.ml))
     (with-accepted-exit-codes
      1
      (run
       %{exe:../driver/driver.exe}
       --config
       rules.ppx_forbid
       -impl
       fail_local_open.ml))
     (with-accepted-exit-codes
      1
      (run
       %{exe:../driver/driver.exe}
       --config
       rules.ppx_forbid
       -impl
       fail_mangled.ml))
     (with-accepted-exit-codes
      1
      (run
       %{exe:../driver/driver.exe}
       --config
       rules.ppx_forbid
       -impl
       fail_open.ml))
     (with-accepted-exit-codes
      1
      (run
       %{exe:../driver/driver.exe}
       --config
       rules.ppx_forbid
       -impl
       fail_open_bang.ml))
     (with-accepted-exit-codes
      1
      (run
       %{exe:../driver/driver.exe}
       --config
       rules.ppx_forbid
       -impl
       fail_qualified.ml))
     (with-accepted-exit-codes
      1
      (run
       %{exe:../driver/driver.exe}
       --config
       rules.ppx_forbid
       -impl
       fail_stdlib_prefix.ml))
     (with-accepted-exit-codes
      1
      (run
       %{exe:../driver/driver.exe}
       --config
       rules.ppx_forbid
       -impl
       fail_submodule.ml)))))))

(rule
 (alias runtest)
 (action
  (diff failures.expected failures.out)))

